{
  "name": "sort-id",
  "version": "0.2.0",
  "description": "Time sortable, type-prefixed IDs.",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "module": "dist/index.js",
  "type": "module",
  "repository": "krobonic/sort-id",
  "author": "Callum Thomson",
  "license": "MIT",
  "exports": {
    ".": {
      "default": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./alphabets": {
      "default": "./dist/alphabets.js",
      "types": "./dist/alphabets.d.ts"
    }
  },
  "scripts": {
    "lint": "biome check src/**/*.ts",
    "lint:write": "biome check src/**/*.ts --write",
    "fmt": "biome format src/**/*.ts --write",
    "build": "rm -rf dist/ && tsc && bun run src/build.ts",
    "test": "bun test",
    "npm:publish": "bun publish"
  },
  "devDependencies": {
    "@biomejs/biome": "2.3.15",
    "@types/bun": "^1.3.8",
    "prettier": "^3.3.2",
    "tslib": "^2.6.3",
    "typescript": "^5.5.2"
  }
}
